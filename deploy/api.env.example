# Copy to /opt/muvance/runtime/api.env on the VPS and fill in. Keep this file secret.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Allow-list the VPS IP in Atlas.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=muvance

# Firebase service account JSON, base64 encoded. Leave out to turn off push notifications.
# FIREBASE_SERVICE_ACCOUNT=

# Meta Conversions API (server copies of the website's Pixel events). Leave out to turn off.
# Token: Events Manager > the pixel > Settings > Conversions API > Generate access token.
# META_PIXEL_ID=1416578116747201
# META_CAPI_TOKEN=
# Only while checking events in Events Manager > Test events; remove afterwards.
# META_TEST_EVENT_CODE=

LOG_LEVEL=info
SESSION_TTL_DAYS=14
