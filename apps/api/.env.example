NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# "memory" starts a throwaway in-memory MongoDB and creates a dev owner account
# (owner@muvance.local / muvance-dev-password). Use a real URI to keep data, e.g.
# mongodb://localhost:27018 (run: docker compose up -d mongo) or a MongoDB Atlas URI.
MONGODB_URI=memory
MONGODB_DB=muvance

# Admin app URL, used in invite and password-reset links.
ADMIN_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Meta Conversions API. Leave out in development unless testing with META_TEST_EVENT_CODE.
# META_PIXEL_ID=1416578116747201
# META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=
